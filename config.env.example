# agent-swarm-mcp, remote instance settings. Copy this file to config.env on
# the server (next to run.sh) and fill it in. config.env is in .gitignore and
# deploy.sh never sends or overwrites it. Run ./run.sh after every change.
# Plain KEY=value lines only (no quotes, no spaces around =).

# Required. Your Claude API key (text) from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required. The server's public host name (DNS name, no https://). It must
# resolve to this server, and port 443 must be reachable from the internet.
SWARM_PUBLIC_HOST=swarm.example.com

# This swarm's name, the prefix of its agents' names (text: lowercase letters,
# digits, "-"; not "local"). Default: remote
# SWARM_INSTANCE_NAME=remote

# HTTPS. Leave empty and run.sh starts its own Caddy on port 443, which gets a
# Let's Encrypt certificate by itself. If a Caddy of yours already owns 443,
# set the name of its Docker network instead (text); the swarm joins it and
# run.sh prints the site block to add (see caddy/site.caddy.example).
# SWARM_CADDY_NETWORK=

# Time zone for timestamps (IANA name). Default: UTC
# TZ=UTC

# Whether conversations started in the web view may spawn helper agents on
# this server (text): none or local. Default: none. With local, helpers are
# nested under their conversation in the sidebar, as on the local swarm.
# Agents calling over MCP can always spawn.
# SWARM_AGENT_SPAWN=none

# Any other setting from .env.example works here too, for example:
# SWARM_DEFAULT_MODEL=sonnet
# SWARM_MAX_PARALLEL=4
