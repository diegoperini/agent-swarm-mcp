# agent-swarm-mcp settings
# Copy this file to .env (same folder) and fill in your key.
# .env is listed in .gitignore: never commit it or share it.
# Lines starting with # are comments. Values may be quoted. Environment
# variables with the same names work too (the Docker image uses them).
# Settings are read at startup: restart the swarm after changing them.
#
# About tokens: models read and write text in tokens. One token is about
# 4 characters, or 3/4 of an English word: 1,000 tokens is roughly 750 words,
# about one and a half pages.

# Required. Your Claude API key (text) from https://console.anthropic.com
ANTHROPIC_API_KEY=

# How this swarm runs (one of: local, remote). Default: local
#   local:  MCP over stdio, launched by your MCP client.
#   remote: MCP over HTTPS for Claude connectors, in Docker (see README).
# SWARM_MODE=local

# Model IDs (text) behind the opus / sonnet / haiku choices, and which choice
# a new agent gets when none is given (one of: opus, sonnet, haiku).
# SWARM_MODEL_OPUS=claude-opus-5-5
# SWARM_MODEL_SONNET=claude-sonnet-5-5
# SWARM_MODEL_HAIKU=claude-haiku-5-5
# SWARM_DEFAULT_MODEL=sonnet

# How hard an agent thinks and works on each reply, when its owner doesn't
# choose (one of: low, medium, high, xhigh, max). Default: medium, which is
# Claude's own default level. Owners can pick another level per agent.
#   low     fastest and cheapest; quick, mechanical work
#   medium  balanced speed, cost and depth; most delegated work
#   high    thinks as much as the task needs; complex reasoning
#   xhigh   long, demanding agentic work; far more output, cost and time
#   max     no limit on thinking; the slowest and most expensive
# SWARM_DEFAULT_EFFORT=medium

# Effort level of non-stop agents when their owner doesn't choose one (same
# values). Default: low: automation (playing a game, running tests) needs
# quick action and reaction more than long thinking.
# SWARM_NONSTOP_EFFORT=low

# What conversations you start in the web view may spawn (text, comma list):
#   local         helper agents on this swarm, nested under the conversation in
#                 the sidebar and archived with it (local_agent_* tools)
#   remote        agents on the remote swarm (remote_agent_* tools; local only)
#   local,remote  both
#   none          neither
# Default: local,remote on the local swarm, none on a remote swarm. Agents that
# call the swarm over MCP can always spawn, whatever this says.
# SWARM_AGENT_SPAWN=local,remote

# Most output one model call may produce, thinking included (tokens).
# Default: 16000 (about 12,000 words). A reply cut off at this limit is not
# lost: the agent is told to continue in smaller steps. Raise it for agents at
# xhigh or max effort if that happens often.
# SWARM_MAX_TOKENS=16000

# Tool calls an agent may make for one owner message before it must stop and
# ask whether to continue (count of tool calls), when its owner doesn't choose.
# Owners can pick another number per conversation; 0 means unlimited.
# Default: 15
# SWARM_TOOL_BUDGET=15

# Size of the context window, for the context meter and the warning (tokens).
# Default: 1000000 (about 750,000 words).
# SWARM_CONTEXT_WINDOW=1000000

# When agents and owners are warned to compact (percent of the context window,
# 1-99). Default: 70
# SWARM_CONTEXT_WARN_PERCENT=70

# Agent turns that may run at the same time (count of turns), not counting
# non-stop agents. Default: 4
# SWARM_MAX_PARALLEL=4

# Non-stop agents (started with "non-stop mode") work continuously until
# paused or archived. They run in their own slots: at most this many at the
# same time (count of agents). Default: 4
# SWARM_MAX_NONSTOP=4

# A non-stop agent compacts itself when its context reaches this size
# (tokens). Default: 800000 (about 600,000 words).
# SWARM_NONSTOP_COMPACT_AT=800000

# When a non-stop agent ends a reply without using a tool, it rests before it
# is told to continue; a message cuts the rest short. While it stays idle, the
# rest is the base for the first minute, then doubles every minute up to the
# cap, so an agent with nothing to do costs almost nothing. Using a tool or
# getting a message resets it. Base and cap (seconds). Defaults: 10 and 600
# SWARM_NONSTOP_IDLE=10
# SWARM_NONSTOP_IDLE_MAX=600

# How long agent_send / agent_spawn wait for a reply when the caller doesn't
# say (seconds; callers can pass 0-300). Default: 50
# SWARM_DEFAULT_WAIT=50

# Longest an agent may sleep in one call of its sleep tool, for example
# between polls (seconds). A message or a stop wakes it early. Default: 3600
# SWARM_SLEEP_MAX=3600

# Agents tend to sleep longer than they need. Until an agent has gone
# SWARM_SLEEP_FREE_AFTER seconds without other work (any other tool call or a
# new message), its sleeps are cut to SWARM_SLEEP_SHORT_MAX seconds.
# Defaults: 30 and 180
# SWARM_SLEEP_SHORT_MAX=30
# SWARM_SLEEP_FREE_AFTER=180

# Size limit of each agent's scratch folder, uploads included (megabytes).
# Default: 1000. One message can attach up to 200 MB of files.
# SWARM_SCRATCH_MAX_MB=1000

# Largest tool result passed to an agent; longer ones are cut (characters).
# Default: 100000
# SWARM_TOOL_RESULT_MAX_CHARS=100000

# Time limits for the MCP servers agents use (seconds): starting one,
# including listing its tools, and one tool call. Defaults: 60 and 300
# SWARM_MCP_START_TIMEOUT=60
# SWARM_MCP_CALL_TIMEOUT=300

# How long the Claude API keeps a cached prompt prefix (one of: 5m = five
# minutes, 1h = one hour). Default: 5m. 1h costs more to write, lasts longer.
# CLAUDE_CACHE_TTL=5m

# API endpoint (URL). Must be https://, except http://localhost for testing.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Where conversations, the archive and the MCP allow list are kept (folder
# path). Default: the state folder next to this file.
# SWARM_STATE_DIR=

# ---------------------------------------------------------------------------
# Local only
# ---------------------------------------------------------------------------
# Web view port on localhost (TCP port number). If busy, the next 9 ports are
# tried. The port is only held while the web view window is open. Default: 8770
# MCP_UI_PORT=8770

# Open the web view when the swarm starts (true or false). Default: true
# MCP_UI_OPEN=true

# Your Claude Desktop config, for "Import from Claude Desktop" (file path).
# Usually found on its own: the swarm looks in %APPDATA%\Claude, in
# %LOCALAPPDATA%\Claude-Data\<id>, in Store-app package folders, and on macOS and
# Linux in their usual places. Set this only if yours lives somewhere else.
# SWARM_CLAUDE_CONFIG=

# The remote swarm this computer manages (your admin gateway): its address
# (https:// URL) and an access key created on that server (text). Leave the
# URL empty to run without a remote. Easier: connect it in the web view's
# Remote tab, which saves it in state\remotes.json.
# SWARM_REMOTE_URL=https://swarm.example.com
# SWARM_REMOTE_KEY=swk_...
# The remote's name (text: lowercase letters, digits, "-"; not "local"). It
# must match the server's SWARM_INSTANCE_NAME; the remote's agents are named
# <name>.<agent>. Default: remote
# SWARM_REMOTE_NAME=remote

# ---------------------------------------------------------------------------
# Remote only (normally set through config.env and run.sh, see README)
# ---------------------------------------------------------------------------
# This server's name, the prefix of its agents' names (text: lowercase
# letters, digits, "-"; not "local"). Default: remote
# SWARM_INSTANCE_NAME=remote
# The server's public address (https:// URL).
# SWARM_PUBLIC_URL=https://swarm.example.com
# Where the server listens inside its container (HttpListener prefix URL).
# SWARM_LISTEN=http://+:8780/
